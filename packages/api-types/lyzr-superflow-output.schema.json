{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carerelay.example/schemas/lyzr-superflow-output-v1.json",
  "title": "CareRelay Lyzr SuperFlow Output v1",
  "type": "object",
  "required": ["care_relay_result"],
  "additionalProperties": false,
  "properties": {
    "care_relay_result": {
      "type": "object",
      "required": ["triage", "critic", "soap"],
      "additionalProperties": false,
      "properties": {
        "triage": { "$ref": "#/$defs/triage" },
        "critic": { "$ref": "#/$defs/critic" },
        "soap": { "$ref": "#/$defs/soap" }
      }
    }
  },
  "$defs": {
    "urgency": { "enum": ["Emergency", "Same-Day", "Routine", "Self-Care"] },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "triage": {
      "type": "object",
      "required": ["provider", "urgency", "confidence", "uncertainty", "rationale_summary"],
      "properties": {
        "schema_version": { "type": "string" },
        "provider": { "type": "string", "minLength": 1 },
        "urgency": { "$ref": "#/$defs/urgency" },
        "confidence": { "$ref": "#/$defs/score" },
        "uncertainty": { "$ref": "#/$defs/score" },
        "rationale_summary": { "type": "string", "minLength": 1 },
        "missing_critical_facts": { "type": "array", "items": { "type": "string" } },
        "citations": { "type": "array" }
      }
    },
    "critic": {
      "type": "object",
      "required": ["provider", "proposed_urgency", "risk_found", "confidence", "summary"],
      "properties": {
        "schema_version": { "type": "string" },
        "provider": { "type": "string", "minLength": 1 },
        "proposed_urgency": { "$ref": "#/$defs/urgency" },
        "risk_found": { "type": "boolean" },
        "confidence": { "$ref": "#/$defs/score" },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_id", "source_type", "label"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["patient", "clinician", "retrieval", "inference"] },
        "label": { "type": "string", "minLength": 1 },
        "quote": { "type": ["string", "null"] }
      }
    },
    "sentence": {
      "type": "object",
      "required": ["text", "confidence", "provenance"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/score" },
        "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenance" } }
      }
    },
    "soap": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "status": { "enum": ["draft"] },
        "sections": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/sentence" } }
        }
      }
    }
  }
}
